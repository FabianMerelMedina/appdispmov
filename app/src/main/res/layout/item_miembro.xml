<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Iniciales -->
        <TextView
            android:id="@+id/tvInicialesMiembro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="JP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4F46E5"
            android:background="#EEF2FF" />

        <!-- Información -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNombreMiembro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_user"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#172033" />

            <TextView
                android:id="@+id/tvCorreoMiembro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/tvRolMiembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4F46E5" />

        </LinearLayout>

        <!-- Eliminar -->
        <TextView
            android:id="@+id/btnEliminarMiembro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/remove_member"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>